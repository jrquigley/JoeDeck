[Unit]
Description=JoeDeck web server
After=network.target

[Service]
User=@USER@
Environment=SIGNAGE_DATA=/var/lib/signage
Environment=SIGNAGE_PORT=@PORT@
ExecStart=/usr/bin/python3 /opt/signage/server.py --port @PORT@
# allows binding to port 80 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
